@model EmployeeVM
<div>
    <table class="table-emp employment-table-emp">
        <thead class="table-head-emp">
            <tr>
                <th>Actions</th>
                <th>Employer</th>
                <th>Designation</th>
                <th>Date of Joining</th>
                <th>Date of Exit</th>
                <th>Type</th>
                <th>Active</th>
                <th>Reason</th>
                <th>Role Performed</th>
                <th>Created By</th>
                <th>Created Date</th>
                <th>Updated By</th>
                <th>Updated Date</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.EmploymentHistory != null && Model.EmploymentHistory.Any())
            {
                foreach (var emp in Model.EmploymentHistory)
                {
                    <tr>
                        <td>Edit</td>
                        <td>@emp.EmployerName</td>
                        <td>@emp.Designation</td>
                        <td>@emp.DateOfJoining.ToString("yyyy-MM-dd")</td>
                        <td>@(emp.DateOfExit?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>@emp.EmploymentType</td>
                        <td>@(emp.IsActive == true ? "Yes" : "No")</td>
                        <td>@(emp.ExitReason ?? "-")</td>
                        <td>@emp.RolePerformed</td>
                        <td>@emp.CreatedBy</td>
                        <td>@(emp.CreatedDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>@emp.UpdatedBy</td>
                        <td>@(emp.UpdatedDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="13" style="text-align: center; padding: 20px; color: #888;">No employment history records found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .table-emp {
        width: 100%;
        border-collapse: separate;
        border-spacing: .5px 2px;
        background-color: transparent;
        text-align: center;
    }

    .employment-table-emp {
        font-size: 13px;
    }

    .table-head-emp {
        background-color: #2466d1;
        color: white;
    }

        .table-head-emp th {
            padding: 8px 10px;
            font-weight: 600;
            text-align: left;
            border: 1px solid white;
        }

    .employment-table-emp td {
        padding: 8px 10px;
        color: #555;
        border: 1px solid white;
        background-color: #f9f9f9;
    }
</style>
