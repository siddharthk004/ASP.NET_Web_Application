@model EmployeeCRUD.Models.EmployeeEmploymentHistory

@using (Html.BeginForm("AddEmploymentHistory", "Employee", FormMethod.Post, new { id = "historyForm" }))
{
    @Html.HiddenFor(m => m.EmployeeId)

    <div class="form-group">
        <label>Employer</label>
        @Html.TextBoxFor(m => m.EmployerName, new { @class = "form-control", required = "required" })
    </div>

    <div class="form-group">
        <label>Designation</label>
        @Html.TextBoxFor(m => m.Designation, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Date Of Joining</label>
        @Html.TextBoxFor(m => m.DateOfJoining, "{0:yyyy-MM-dd}",
        new { @class = "form-control", type = "date" })
    </div>

    <div class="form-group">
        <label>Employment Type</label>
        @Html.TextBoxFor(m => m.EmploymentType, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Role Performed</label>
        @Html.TextBoxFor(m => m.RolePerformed, new { @class = "form-control" })
    </div>

    <div class="text-end mt-3">
        <button type="submit" class="btn btn-success">Save</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
}
<script>
    $(document).ready(function () {
        $('#historyForm').on('submit', function (e) {
            e.preventDefault();

            var form = $(this);
            var submitBtn = form.find('button[type="submit"]');
            submitBtn.prop('disabled', true).text('Saving...');

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function (res) {
                    if (res.success) {
                        alert('Employment history added successfully!');
                        $('#historyModal').modal('hide');
                        location.reload();
                    } else {
                        alert('Error: ' + (res.message || 'Failed to save employment history'));
                        submitBtn.prop('disabled', false).text('Save');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('AJAX Error:', error);
                    console.error('Response:', xhr.responseText);
                    alert('Error saving employment history. Please check the console for details.');
                    submitBtn.prop('disabled', false).text('Save');
                }
            });
        });
    });
</script>
