@{
    ViewBag.Title = "Dashboard";
}

<div class="dashboard-grid fade-in">
    <div class="stat-card">
        <div class="icon"><i class="fas fa-fire"></i></div>
        <h3>@ViewBag.CompletedHabits/@ViewBag.TodayHabits</h3>
        <p>Habits Today</p>
    </div>

    <div class="stat-card warning">
        <div class="icon"><i class="fas fa-tasks"></i></div>
        <h3>@ViewBag.PendingTasks</h3>
        <p>Pending Tasks</p>
    </div>

    <div class="stat-card danger">
        <div class="icon"><i class="fas fa-wallet"></i></div>
        <h3>?@ViewBag.MonthlyExpenses.ToString("N0")</h3>
        <p>Monthly Expenses</p>
    </div>

    <div class="stat-card info">
        <div class="icon"><i class="fas fa-stopwatch"></i></div>
        <h3>@ViewBag.TodayFocusMinutes min</h3>
        <p>Focus Time Today</p>
    </div>
</div>

<div class="content-card fade-in">
    <div class="card-header">
        <h5><i class="fas fa-chart-line"></i> Welcome, @ViewBag.UserName!</h5>
    </div>
    <div style="text-align: center; padding: 40px 20px;">
        <i class="fas fa-rocket" style="font-size: 64px; color: var(--primary); margin-bottom: 20px;"></i>
        <h4>Your Life Management Dashboard</h4>
        <p style="color: #64748b; max-width: 600px; margin: 20px auto;">
            Track your daily habits, manage tasks, monitor expenses, and maintain your productivity and well-being all in one place.
        </p>
        <div style="margin-top: 30px; display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
            <a href="@Url.Action("Index", "Habits")" class="btn btn-primary">
                <i class="fas fa-fire"></i> Start with Habits
            </a>
            <a href="@Url.Action("Index", "Task")" class="btn btn-success">
                <i class="fas fa-tasks"></i> View Tasks
            </a>
        </div>
    </div>
</div>

@if (ViewBag.TodayMood > 0)
{
    <div class="content-card fade-in">
        <div class="card-header">
            <h5><i class="fas fa-smile"></i> Today's Mood</h5>
        </div>
        <div style="text-align: center; padding: 30px;">
            <div style="font-size: 48px;">
                @if (ViewBag.TodayMood == 5) { <span>??</span> }
                else if (ViewBag.TodayMood == 4) { <span>??</span> }
                else if (ViewBag.TodayMood == 3) { <span>??</span> }
                else if (ViewBag.TodayMood == 2) { <span>??</span> }
                else if (ViewBag.TodayMood == 1) { <span>??</span> }
            </div>
            <h3 style="margin-top: 15px;">Level @ViewBag.TodayMood/5</h3>
        </div>
    </div>
}
