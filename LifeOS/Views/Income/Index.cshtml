@model List<Income>
@{
    ViewBag.Title = "Income";
}

<div class="content-card fade-in">
    <div class="card-header">
        <h5><i class="fas fa-money-bill-wave"></i> Add Income</h5>
    </div>
    <form method="post" action="/Income/Add" class="add-form">
        <div class="form-row">
            <select name="month" class="form-control" required>
                <option value="">Select Month</option>
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i" selected="@(i == DateTime.Now.Month)">
                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)
                    </option>
                }
            </select>
            <select name="year" class="form-control" required>
                @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                {
                    <option value="@y">@y</option>
                }
            </select>
            <input name="monthlyIncome" type="number" step="0.01" class="form-control" placeholder="Income Amount (?)" required />
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add/Update Income
            </button>
        </div>
    </form>
</div>

<div class="content-card fade-in">
    <div class="card-header">
        <h5><i class="fas fa-chart-line"></i> Income History</h5>
    </div>

    @if (Model.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Month</th>
                    <th>Year</th>
                    <th>Monthly Income</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var income in Model)
                {
                    <tr>
                        <td><strong>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(income.Month)</strong></td>
                        <td>@income.Year</td>
                        <td style="font-size: 16px; font-weight: 600; color: var(--success);">?@income.MonthlyIncome.ToString("N2")</td>
                        <td>
                            <a href="/Income/Delete/@income.IncomeId" class="btn btn-danger btn-sm" onclick="return confirm('Delete this income record?')">
                                <i class="fas fa-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-dollar-sign"></i>
            <p>No income records yet. Add your income above!</p>
        </div>
    }
</div>
