@model List<FocusLog>
@{
    ViewBag.Title = "Focus Time";
}

<div class="content-card fade-in">
    <div class="card-header">
        <h5><i class="fas fa-clock"></i> Log Focus Time</h5>
    </div>
    <form method="post" action="/Focus/Add" class="add-form">
        <div class="form-row">
            <select name="category" class="form-control" required>
                <option value="">Select Category</option>
                <option value="Coding">Coding</option>
                <option value="Study">Study</option>
                <option value="Reading">Reading</option>
                <option value="Writing">Writing</option>
                <option value="Exercise">Exercise</option>
                <option value="Meditation">Meditation</option>
                <option value="Work">Work</option>
                <option value="Other">Other</option>
            </select>
            <input name="minutesSpent" type="number" class="form-control" placeholder="Minutes spent" required />
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-plus"></i> Log Time
            </button>
        </div>
    </form>
</div>

<div class="content-card fade-in">
    <div class="card-header">
        <h5><i class="fas fa-chart-bar"></i> Focus Logs (Last 7 Days)</h5>
        <div>
            <h4 style="color: var(--info); margin: 0;">
                <i class="fas fa-stopwatch"></i> @ViewBag.TodayTotal min today
            </h4>
        </div>
    </div>

    @if (Model.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date & Time</th>
                    <th>Category</th>
                    <th>Duration</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>@log.LogDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                        <td><span class="badge badge-info">@log.Category</span></td>
                        <td style="font-size: 16px; font-weight: 600; color: var(--info);">
                            <i class="fas fa-clock"></i> @log.MinutesSpent minutes
                        </td>
                        <td>
                            <a href="/Focus/Delete/@log.FocusId" class="btn btn-danger btn-sm" onclick="return confirm('Delete this log?')">
                                <i class="fas fa-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr style="background: var(--light); font-weight: 700;">
                    <td colspan="2" style="text-align: right; padding-right: 20px;">TOTAL TIME:</td>
                    <td style="font-size: 18px; color: var(--info);">
                        <i class="fas fa-stopwatch"></i> @Model.Sum(f => f.MinutesSpent) min 
                        (@Math.Round(Model.Sum(f => f.MinutesSpent) / 60.0, 1) hrs)
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-stopwatch"></i>
            <p>No focus logs yet. Start tracking your productive time above!</p>
        </div>
    }
</div>
