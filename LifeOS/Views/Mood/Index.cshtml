@model List<MoodLog>
@{
    ViewBag.Title = "Mood Tracker";
}

<div class="content-card fade-in">
    <div class="card-header">
        <h5><i class="fas fa-smile"></i> Log Today's Mood</h5>
    </div>
    <form method="post" action="/Mood/Add" class="add-form">
        <div style="text-align: center; padding: 20px;">
            <p style="margin-bottom: 20px; font-weight: 600; color: var(--dark);">How are you feeling today?</p>
            <div style="display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; margin-bottom: 20px;">
                <label style="cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.2)'" onmouseout="this.style.transform='scale(1)'">
                    <input type="radio" name="moodLevel" value="1" required style="display: none;">
                    <div style="font-size: 48px; padding: 10px; border: 3px solid transparent; border-radius: 50%;" onclick="this.parentElement.style.border='3px solid var(--primary)'; document.querySelectorAll('label').forEach(l => l !== this.parentElement && (l.style.border='3px solid transparent'));">??</div>
                    <small>Very Bad</small>
                </label>
                <label style="cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.2)'" onmouseout="this.style.transform='scale(1)'">
                    <input type="radio" name="moodLevel" value="2" required style="display: none;">
                    <div style="font-size: 48px; padding: 10px; border: 3px solid transparent; border-radius: 50%;" onclick="this.parentElement.style.border='3px solid var(--primary)'; document.querySelectorAll('label').forEach(l => l !== this.parentElement && (l.style.border='3px solid transparent'));">??</div>
                    <small>Bad</small>
                </label>
                <label style="cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.2)'" onmouseout="this.style.transform='scale(1)'">
                    <input type="radio" name="moodLevel" value="3" required style="display: none;">
                    <div style="font-size: 48px; padding: 10px; border: 3px solid transparent; border-radius: 50%;" onclick="this.parentElement.style.border='3px solid var(--primary)'; document.querySelectorAll('label').forEach(l => l !== this.parentElement && (l.style.border='3px solid transparent'));">??</div>
                    <small>Okay</small>
                </label>
                <label style="cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.2)'" onmouseout="this.style.transform='scale(1)'">
                    <input type="radio" name="moodLevel" value="4" required style="display: none;">
                    <div style="font-size: 48px; padding: 10px; border: 3px solid transparent; border-radius: 50%;" onclick="this.parentElement.style.border='3px solid var(--primary)'; document.querySelectorAll('label').forEach(l => l !== this.parentElement && (l.style.border='3px solid transparent'));">??</div>
                    <small>Good</small>
                </label>
                <label style="cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.2)'" onmouseout="this.style.transform='scale(1)'">
                    <input type="radio" name="moodLevel" value="5" required style="display: none;">
                    <div style="font-size: 48px; padding: 10px; border: 3px solid transparent; border-radius: 50%;" onclick="this.parentElement.style.border='3px solid var(--primary)'; document.querySelectorAll('label').forEach(l => l !== this.parentElement && (l.style.border='3px solid transparent'));">??</div>
                    <small>Excellent</small>
                </label>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-check"></i> Log Mood
            </button>
        </div>
    </form>
</div>

<div class="content-card fade-in">
    <div class="card-header">
        <h5><i class="fas fa-chart-line"></i> Mood History (Last 30 Days)</h5>
        <div>
            <h4 style="color: var(--info); margin: 0;">
                Avg: @ViewBag.AverageMood.ToString("F1")/5.0
            </h4>
        </div>
    </div>

    @if (Model.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Mood</th>
                    <th>Level</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mood in Model)
                {
                    <tr>
                        <td>@mood.MoodDate.ToString("MMM dd, yyyy")</td>
                        <td style="font-size: 32px;">
                            @if (mood.MoodLevel == 5) { <span>??</span> }
                            else if (mood.MoodLevel == 4) { <span>??</span> }
                            else if (mood.MoodLevel == 3) { <span>??</span> }
                            else if (mood.MoodLevel == 2) { <span>??</span> }
                            else if (mood.MoodLevel == 1) { <span>??</span> }
                        </td>
                        <td>
                            @if (mood.MoodLevel >= 4)
                            {
                                <span class="badge badge-success">@mood.MoodLevel / 5</span>
                            }
                            else if (mood.MoodLevel == 3)
                            {
                                <span class="badge badge-info">@mood.MoodLevel / 5</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">@mood.MoodLevel / 5</span>
                            }
                        </td>
                        <td>
                            <a href="/Mood/Delete/@mood.MoodId" class="btn btn-danger btn-sm" onclick="return confirm('Delete this mood log?')">
                                <i class="fas fa-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-smile"></i>
            <p>No mood logs yet. Start tracking your mood above!</p>
        </div>
    }
</div>
