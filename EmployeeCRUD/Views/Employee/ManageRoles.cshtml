@model List<EmployeeCRUD.Models.RoleManagementVM>

@{
    ViewBag.Title = "Manage User Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f5f5f5;
        padding: 20px;
    }

    .role-management-container {
        max-width: 1400px;
        margin: 0 auto;
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .role-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 25px 30px;
    }

    .role-header h2 {
        margin: 0;
        font-size: 24px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .role-header i {
        font-size: 28px;
    }

    .table-container {
        padding: 20px;
        overflow-x: auto;
    }

    .role-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    .role-table thead {
        background: #f8f9fa;
        position: sticky;
        top: 0;
        z-index: 1;
    }

    .role-table th {
        padding: 15px 10px;
        text-align: center;
        font-weight: 600;
        color: #495057;
        border-bottom: 2px solid #dee2e6;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .role-table th:first-child {
        text-align: left;
        padding-left: 20px;
    }

    .role-table td {
        padding: 18px 10px;
        border-bottom: 1px solid #e9ecef;
        text-align: center;
        color: #495057;
    }

    .role-table td:first-child {
        text-align: left;
        padding-left: 20px;
        font-weight: 500;
    }

    .role-table tbody tr {
        transition: background-color 0.2s ease;
    }

    .role-table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .role-name {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .role-badge.admin {
        background: #ffe2e2;
        color: #dc3545;
    }

    .role-badge.user {
        background: #e7f3ff;
        color: #0056b3;
    }

    .role-badge.manager {
        background: #fff3cd;
        color: #856404;
    }

    input[type="checkbox"] {
        width: 20px;
        height: 20px;
        cursor: pointer;
        accent-color: #667eea;
    }

    .view-type-select {
        padding: 8px 12px;
        border: 2px solid #e0e0e0;
        border-radius: 6px;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.3s ease;
        background: white;
    }

    .view-type-select:focus {
        outline: none;
        border-color: #667eea;
    }

    .view-type-select option {
        padding: 8px;
    }

    .button-group {
        padding: 20px 30px;
        border-top: 1px solid #e9ecef;
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        background: #f8f9fa;
    }

    .btn {
        padding: 12px 40px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn i {
        font-size: 16px;
    }

    .btn-save {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    }

    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(102, 126, 234, 0.4);
    }

    .btn-close {
        background: #6c757d;
        color: white;
    }

    .btn-close:hover {
        background: #5a6268;
        transform: translateY(-2px);
    }

    .checkbox-group {
        display: flex;
        gap: 8px;
        align-items: center;
        justify-content: center;
    }

    @@media (max-width: 1200px) {
        .role-table {
            font-size: 12px;
        }

        .role-table th,
        .role-table td {
            padding: 12px 8px;
        }
    }
</style>

<div class="role-management-container">
    <div class="role-header">
        <h2>
            <i class="fas fa-users-cog"></i>
            User Role Management
        </h2>
    </div>

    <form id="roleManagementForm">
        <div class="table-container">
            <table class="role-table">
                <thead>
                    <tr>
                        <th>Role Name</th>
                        <th>ID</th>
                        <th>Role View ID</th>
                        <th><i class="fas fa-briefcase"></i> Full Time</th>
                        <th><i class="fas fa-clock"></i> Part Time</th>
                        <th><i class="fas fa-user-graduate"></i> Internship</th>
                        <th><i class="fas fa-laptop-code"></i> Freelance</th>
                        <th><i class="fas fa-file-contract"></i> Contract</th>
                        <th><i class="fas fa-hourglass"></i> Temporary</th>
                        <th>View Type</th>
                        <th>Is Active</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var roleClass = Model[i].RoleId == 1 ? "admin" : Model[i].RoleId == 2 ? "manager" : "user";

                        <tr>
                            <td>
                                <div class="role-name">
                                    <span class="role-badge @roleClass">
                                        @Model[i].RoleName
                                    </span>
                                </div>
                                <input type="hidden" name="roles[@i].Id" value="@Model[i].Id" />
                                <input type="hidden" name="roles[@i].RoleId" value="@Model[i].RoleId" />
                                <input type="hidden" name="roles[@i].RoleTypeViewId" value="@Model[i].RoleTypeViewId" />
                            </td>
                            <td>@Model[i].Id</td>
                            <td>@Model[i].RoleTypeViewId</td>
                            <td>
                                <input type="checkbox"
                                       name="roles[@i].FullTime"
                                       value="true"
                                       @(Model[i].FullTime ? "checked" : "") />
                                <input type="hidden" name="roles[@i].FullTime" value="false" />
                            </td>
                            <td>
                                <input type="checkbox"
                                       name="roles[@i].PartTime"
                                       value="true"
                                       @(Model[i].PartTime ? "checked" : "") />
                                <input type="hidden" name="roles[@i].PartTime" value="false" />
                            </td>
                            <td>
                                <input type="checkbox"
                                       name="roles[@i].Internship"
                                       value="true"
                                       @(Model[i].Internship ? "checked" : "") />
                                <input type="hidden" name="roles[@i].Internship" value="false" />
                            </td>
                            <td>
                                <input type="checkbox"
                                       name="roles[@i].Freelance"
                                       value="true"
                                       @(Model[i].Freelance ? "checked" : "") />
                                <input type="hidden" name="roles[@i].Freelance" value="false" />
                            </td>
                            <td>
                                <input type="checkbox"
                                       name="roles[@i].Contract"
                                       value="true"
                                       @(Model[i].Contract ? "checked" : "") />
                                <input type="hidden" name="roles[@i].Contract" value="false" />
                            </td>
                            <td>
                                <input type="checkbox"
                                       name="roles[@i].Temporary"
                                       value="true"
                                       @(Model[i].Temporary ? "checked" : "") />
                                <input type="hidden" name="roles[@i].Temporary" value="false" />
                            </td>
                            <td>
                                <select name="roles[@i].ViewType" class="view-type-select">
                                    <option value="0" @(Model[i].ViewType == 0 ? "selected" : "")>Active</option>
                                    <option value="1" @(Model[i].ViewType == 1 ? "selected" : "")>Inactive</option>
                                    <option value="2" @(Model[i].ViewType == 2 ? "selected" : "")>Both</option>
                                </select>
                            </td>
                            <td>
                                <input type="checkbox"
                                       name="roles[@i].IsActive"
                                       value="true"
                                       @(Model[i].IsActive ? "checked" : "") />
                                <input type="hidden" name="roles[@i].IsActive" value="false" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="button-group">
            <button type="submit" class="btn btn-save" id="btnSaveRoles">
                <i class="fas fa-save"></i>
                Save Changes
            </button>
            <button type="button" class="btn btn-close" onclick="window.close()">
                Close
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#roleManagementForm').on('submit', function (e) {
                e.preventDefault();

                var $submitBtn = $('#btnSaveRoles');
                var originalText = $submitBtn.html();

                // Disable button and show loading state
                $submitBtn.prop('disabled', true);
                $submitBtn.html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.ajax({
                    url: '@Url.Action("UpdateRoleSettings", "Employee")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            $submitBtn.html('<i class="fas fa-check"></i> Saved!');

                            // Refresh parent window if exists
                            if (window.opener && !window.opener.closed) {
                                // Force reload with cache clear
                                setTimeout(function() {
                                    window.opener.location.href = window.opener.location.href;
                                }, 500);
                            }

                            // Close window after delay
                            setTimeout(function () {
                                window.close();
                            }, 1500);
                        } else {
                            alert('Error: ' + (response.message || 'Failed to update role settings'));
                            $submitBtn.prop('disabled', false);
                            $submitBtn.html(originalText);
                        }
                    },
                    error: function (xhr, status, error) {
                        alert('Error saving role settings: ' + error);
                        $submitBtn.prop('disabled', false);
                        $submitBtn.html(originalText);
                    }
                });
            });
        });
    </script>
}
