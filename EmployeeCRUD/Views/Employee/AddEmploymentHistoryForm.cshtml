@model EmployeeCRUD.Models.EmployeeEmploymentHistory

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #f5f5f5;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 20px;
    }

    .modal-container {
        background: white;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        max-width: 800px;
        margin: 0 auto;
    }

    .modal-header {
        background-color: #f8f9fa;
        padding: 15px 20px;
        border-bottom: 1px solid #dee2e6;
        border-radius: 8px 8px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-title {
        font-size: 18px;
        font-weight: 600;
        color: #212529;
        margin: 0;
    }

    .close-btn {
        background: none;
        border: none;
        font-size: 24px;
        color: #6c757d;
        cursor: pointer;
        padding: 0;
        width: 30px;
        height: 30px;
        line-height: 1;
    }

        .close-btn:hover {
            color: #000;
        }

    .modal-body {
        padding: 25px;
    }

    .form-row {
        display: flex;
        gap: 20px;
        margin-bottom: 20px;
    }

    .form-group {
        flex: 1;
    }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            color: #495057;
            margin-bottom: 6px;
        }

    .form-control {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 14px;
        transition: border-color 0.15s;
        box-sizing: border-box;
    }

        .form-control:focus {
            outline: none;
            border-color: #80bdff;
            box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25);
        }

        .form-control.error {
            border-color: #dc3545;
        }

    .error-message {
        color: #dc3545;
        font-size: 12px;
        margin-top: 4px;
        display: none;
    }

        .error-message.show {
            display: block;
        }

    textarea.form-control {
        resize: vertical;
        min-height: 80px;
    }

    select.form-control {
        appearance: none;
        background-repeat: no-repeat;
        background-position: right 10px center;
        padding-right: 30px;
    }

    .radio-group {
        display: flex;
        gap: 20px;
        margin-top: 8px;
    }

        .radio-group label {
            display: flex;
            align-items: center;
            font-weight: normal;
            margin-bottom: 0;
        }

        .radio-group input[type="radio"] {
            margin-right: 6px;
        }

    .modal-footer {
        padding: 15px 25px;
        border-top: 1px solid #dee2e6;
        text-align: right;
    }

    .btn {
        padding: 8px 20px;
        border-radius: 4px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        border: 1px solid transparent;
        transition: all 0.15s;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
        border-color: #6c757d;
        margin-right: 10px;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

    .btn-primary {
        background-color: #007bff;
        color: white;
        border-color: #007bff;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }
</style>

<div class="modal-container">
    <div class="modal-header">
        <h5 class="modal-title">Previous Employment Details</h5>
    </div>

    @using (Html.BeginForm("AddEmploymentHistory", "Employee", FormMethod.Post, new { id = "historyForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.EmployeeId)

        <div class="modal-body">
            <div class="form-row">
                <div class="form-group">
                    <label>Employer</label>
                    @Html.TextBoxFor(m => m.EmployerName, new { @class = "form-control", placeholder = "Company Name", id = "employer" })
                    <span class="error-message" id="employer-error">Employer is required</span>
                </div>

                <div class="form-group">
                    <label>Type</label>
                    @Html.DropDownListFor(m => m.EmploymentType, (IEnumerable<SelectListItem>)ViewBag.EmploymentTypes, "Select Type", new { @class = "form-control", id = "type" })
                    <span class="error-message" id="type-error">type is required</span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Designation</label>
                    @Html.TextBoxFor(m => m.Designation, new { @class = "form-control", placeholder = "Designation", id = "designation" })
                    <span class="error-message" id="designation-error">Designation is required</span>
                </div>

                <div class="form-group">
                    <label>Date of Joining</label>
                    @Html.TextBoxFor(m => m.DateOfJoining, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", placeholder = "Choose a date", id = "dateJoining" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Date of Ending</label>
                    @Html.TextBoxFor(m => m.DateOfExit, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", placeholder = "Choose a date" })
                </div>

                <div class="form-group">
                    <label>Roles Performed</label>
                    @Html.TextAreaFor(m => m.RolePerformed, new { @class = "form-control", placeholder = "Roles Performed", rows = "3" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Reason for Leaving</label>
                    @Html.TextAreaFor(m => m.ExitReason, new { @class = "form-control", placeholder = "Reason for Leaving", rows = "3" })
                </div>

                <div class="form-group">
                    <label>Active</label>
                    <div class="radio-group">
                        <label>
                            @Html.RadioButtonFor(m => m.IsActive, true, new { @checked = "checked" })
                            Yes
                        </label>
                        <label>
                            @Html.RadioButtonFor(m => m.IsActive, false)
                            No
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="window.close()">Close</button>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#historyForm').on('submit', function (e) {
                e.preventDefault();

                // Clear previous errors
                $('.error-message').removeClass('show');
                $('.form-control').removeClass('error');

                // Validate
                var isValid = true;

                if (!$('#employer').val().trim()) {
                    $('#employer').addClass('error');
                    $('#employer-error').addClass('show');
                    isValid = false;
                }

                if (!$('#type').val()) {
                    $('#type').addClass('error');
                    $('#type-error').addClass('show');
                    isValid = false;
                }

                if (!$('#designation').val().trim()) {
                    $('#designation').addClass('error');
                    $('#designation-error').addClass('show');
                    isValid = false;
                }

                if (!isValid) {
                    return;
                }

                $.ajax({
                    url: this.action,
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (res) {
                        if (res && res.success === true) {
                            if (window.opener && !window.opener.closed) {
                                if (typeof window.opener.refreshEmploymentHistory === 'function') {
                                    window.opener.refreshEmploymentHistory();
                                } else {
                                    window.opener.location.reload();
                                }
                            }
                            window.close();
                        } else {
                            alert('Error saving employment history');
                        }
                    },
                    error: function () {
                        alert('Failed to save. Please try again.');
                    }
                });
            });

            // Remove error styling when user types
            $('.form-control').on('input change', function () {
                $(this).removeClass('error');
                $(this).siblings('.error-message').removeClass('show');
            });
        });
    </script>
}