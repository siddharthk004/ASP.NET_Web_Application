@using EmployeeCRUD.Controllers
@model EmployeeCRUD.Models.EmployeeVM
<div>
    <div class="table-toolbar">
        <input type="search"
               class="search-box"
               placeholder="Search employer…"
               onkeyup="searchEmploymentHistory(this.value)" />
        <button class="dropbtn" onclick="OpenPopUp(@ViewBag.id)">
            <i class="fa-solid fa-plus"></i>
        </button>
    </div>
    <table class="table-emp employment-table-emp">
        <thead class="table-head-emp">
            <tr>
                <th>Actions</th>
                <th>Employer</th>
                <th>Designation</th>
                <th>Date of Joining</th>
                <th>Date of Exit</th>
                <th>Type</th>
                <th>Active</th>
                <th>Reason</th>
                <th>Role Performed</th>
                <th>Created By</th>
                <th>Created Date</th>
                <th>Updated By</th>
                <th>Updated Date</th>
            </tr>
        </thead>
        <tbody id="employmentHistoryBody">
            @Html.Partial("_EmploymentHistoryRows", Model)
        </tbody>
    </table>
</div>

<script>
    let searchTimer = null;

    function searchEmploymentHistory(keyword) {

        clearTimeout(searchTimer);

        searchTimer = setTimeout(function () {

            $.ajax({
                url: '@Url.Action("SearchEmploymentHistory", "Employee")',
                type: 'GET',
                data: {
                    employeeId: @ViewBag.id,
                    search: keyword
                },
                success: function (html) {
                    $('#employmentHistoryBody').html(html);
                },
                error: function () {
                    alert('Error loading data');
                }
            });

        }, 300); // debounce (important)
    }

    function OpenPopUp(employeeId) {
        console.log(employeeId);
        if (!employeeId || employeeId === 0) {
            alert('Invalid employee ID');
            return;
        }

        var url = '/Employee/AddEmploymentHistory?employeeId=' + employeeId;
        window.open(
            url,
            'EmployeePopup',
            'width=650,height=670,top=130,left=600,resizable=yes,scrollbars=yes'
        );
    }

    window.refreshEmploymentHistory = function() {
        var employeeId = @ViewBag.id;
        if (typeof loadTab === 'function') {
        loadTab('EmploymentHistory', employeeId);
        } else {
        location.reload();
        }
        }

        function OpenPopUpDelete(historyId, btn) {
        if (!confirm('Are you sure you want to delete this employment history?'))
        return;
        $.ajax({
        url: '@Url.Action("DeleteEmployeeHistory", "Employee")',
        type: 'POST',
        data: { id: historyId },
        success: function (res) {
        if (res.success) {
        // ✅ remove only this row
        $(btn).closest('tr').fadeOut(300, function () {
        $(this).remove();
        });
        } else {
        alert(res.message);
        }
        },
        error: function () {
        alert('Error deleting record');
        }
        });
        }

        function OpenPopUpEdit(historyId) {
        if (!historyId || historyId === 0) {
        alert('Invalid record');
        return;
        }

        var url = '/Employee/EditEmploymentHistory?id=' + historyId;

        window.open(
        url,
        'EditEmploymentHistory',
        'width=650,height=670,top=130,left=600,resizable=yes,scrollbars=yes'
        );
        }
</script>

<style>
    .table-toolbar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 10px;
    }

    .search-box {
        width: 180px;
        padding: 6px 10px;
        font-size: 13px;
        border: 1px solid #ccc;
        border-radius: 4px;
        outline: none;
    }

        .search-box:focus {
            border-color: #2466d1;
        }

    .table-emp {
        width: 100%;
        border-collapse: separate;
        border-spacing: .5px 2px;
        background-color: transparent;
        text-align: center;
    }

    .employment-table-emp {
        font-size: 13px;
    }

    .table-head-emp {
        background-color: #2466d1;
        color: white;
    }

        .table-head-emp th {
            padding: 8px 10px;
            font-weight: 600;
            text-align: left;
            border: 1px solid white;
        }

    .employment-table-emp td {
        padding: 8px 10px;
        color: #555;
        border: 1px solid white;
        background-color: #f9f9f9;
    }

    .fa-pen-to-square {
        color: forestgreen;
    }

    .fa-trash {
        color: red;
    }

    .dropbtn {
        margin-left: 5px;
    }
</style>